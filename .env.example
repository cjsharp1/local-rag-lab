# ---------------------------------------------------------------------------
# Template for the environment file.
#
# This file IS committed and holds no secrets. Copy it to .env if you want
# one — .env is git-ignored, so anything you put there stays on your machine.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# You do NOT need this file to run the lab. Every setting below has a working
# default; a .env only matters if you want to change one.
#
# ---------------------------------------------------------------------------
# Why there is no API key here
# ---------------------------------------------------------------------------
#
# Most AI app templates start with an API key. This one does not, and that
# absence is the point: THIS LAB NEVER CALLS A HOSTED MODEL.
#
# Both models, the one that answers and the one that turns text into
# vectors, run on your machine through Ollama. The corpus and its index sit
# in files next to this one. No question, chunk or embedding leaves the
# machine.
# ---------------------------------------------------------------------------

# Port the lab's UI (chat, retrieval panel, log, compare view, map) listens on.
PORT=3400

# Port the tool MCP server listens on when run over HTTP with
# `npm run tool-server:http` — for MCP Inspector or another MCP client.
# The app itself does not use this: it talks to the tool server over stdio.
TOOL_SERVER_PORT=3401

# Where Ollama is listening. This is Ollama's own default.
#
# Keep it on localhost. Pointing it at another machine sends every question
# and every retrieved chunk across the network — the thing this project
# exists to avoid. Both the app (chat) and the tool server (embeddings)
# read this setting.
OLLAMA_URL=http://127.0.0.1:11434

# The chat model: the one that writes answers and, in search-tool mode,
# decides whether and what to search. llama3.2:3b is selectable in the UI.
#
# Must be a LOCAL model. Names ending in ":cloud" run on ollama.com, and the
# lab refuses them.
MODEL=qwen3.5:4b

# The embeddings model: turns each chunk (at index time) and each query (at
# question time) into a vector. Changing it means rebuilding the indexes,
# because vectors from two different models can't be compared.
#
# On a 4 GB GPU, both models stay loaded at once at NUM_CTX=8192, so a
# question doesn't pay to swap between them (measured; see
# docs/verified-facts.md).
EMBED_MODEL=nomic-embed-text

# Context window, in tokens, sent as options.num_ctx on every chat request.
#
# Set explicitly because Ollama's default is small (4096 on most laptops),
# and when a request outgrows it Ollama SILENTLY DROPS whole older
# messages — keeping the system prompt and the newest message, reporting no
# error. In a RAG lab the dropped message is often the retrieved context
# itself. The context budget keeps chunks inside this window, and the lab
# flags it when something is dropped anyway.
NUM_CTX=8192
