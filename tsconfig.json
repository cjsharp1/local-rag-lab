{
  // ---------------------------------------------------------------------------
  // TypeScript configuration for Local RAG Lab — the Node side.
  //
  // This project has three parts, two of which compile from here:
  //   server/       runs in Node    (the app: Express, the three modes, the
  //                                  context budget and prompt assembly)
  //   tool-server/  runs in Node    (the MCP server, as its own process: the
  //                                  only code that reads the corpus and index)
  //   public/       runs in a tab   (the UI — see tsconfig.client.json)
  // plus scripts/ and test/, which run in Node too.
  //
  // Each option below is annotated with what it does and why this project
  // wants it, so the config itself is part of the teaching material.
  // ---------------------------------------------------------------------------
  "compilerOptions": {
    // --- Language and module system ------------------------------------------

    // Which JavaScript version to emit. ES2022 gives us top-level await, which
    // the Node scripts use, and is supported by every current browser.
    "target": "ES2022",

    // Which module syntax to emit. "NodeNext" tells TypeScript to follow Node's
    // own rules, reading "type": "module" from package.json. That is what makes
    // import/export work in .ts files here instead of require().
    //
    // It is also load-bearing for the MCP packages: they declare subpath
    // exports ("@modelcontextprotocol/server/stdio"), and NodeNext is what
    // resolves those subpaths to the right type definitions.
    "module": "NodeNext",

    // How to find a file when you write an import. Must pair with the module
    // setting above; "NodeNext" applies Node's real resolution algorithm —
    // which is why relative imports here end in ".js" even though the file on
    // disk is ".ts".
    "moduleResolution": "NodeNext",

    // Built-in type definitions to include. ES2022 gives the language APIs.
    // DOM supplies fetch, Request and Response: the Ollama client and the
    // embedder use fetch, and the MCP HTTP handler is built on the
    // web-standard types rather than Node's own http objects.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Ambient type packages to load from node_modules/@types. Naming "node"
    // here brings in process, Buffer and the rest of the Node globals —
    // including the types for node:sqlite, which holds the index. @types/node
    // is pinned to the 24 line to match the Node version this project targets.
    "types": ["node"],

    // --- Type checking strictness --------------------------------------------

    // Turns on the full family of strict checks at once, including
    // strictNullChecks. Deliberate for a teaching app: MCP results and Ollama
    // responses are full of optional fields (a response may or may not carry
    // tool_calls), and strict mode forces you to check before reading.
    "strict": true,

    // Flags variables you declare and never use. Keeps the example code honest.
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Requires every code path in a function to return a value when any does.
    "noImplicitReturns": true,

    // Forces array and object index access to be treated as possibly
    // undefined, so vectors[i] has to be checked before use. Retrieval code
    // indexes arrays constantly — vectors, ranks, candidates — and an empty
    // search result is a normal outcome, not an edge case.
    "noUncheckedIndexedAccess": true,

    // --- Interop and output ---------------------------------------------------

    // Allows `import express from "express"` against packages that use the
    // older CommonJS export style. Without it those imports need awkward syntax.
    "esModuleInterop": true,

    // Catches imports that differ from the file name only by letter case, which
    // breaks on Linux even when it works on Windows.
    "forceConsistentCasingInFileNames": true,

    // Where compiled JavaScript goes, and what the paths inside it are relative
    // to. rootDir "." keeps the server/ and tool-server/ split intact under
    // dist/ — which is what lets the app find dist/tool-server/stdio.js to
    // spawn after a build.
    "outDir": "dist",
    "rootDir": ".",

    // Emit .js.map files so stack traces and DevTools point at the TypeScript
    // source rather than the compiled output.
    "sourceMap": true,

    // Skips type checking inside node_modules. Large dependency type trees are
    // slow to re-check and are not your code's problem.
    "skipLibCheck": true
  },

  // Which files belong to THIS config: the Node side of the project.
  //
  // public/ is deliberately absent. The browser half compiles under
  // tsconfig.client.json instead, which gives it browser settings and emits
  // app.js beside app.ts. Listing it here as well would compile it twice,
  // under the wrong settings the second time.
  "include": [
    "server/**/*.ts",
    "tool-server/**/*.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts"
  ]
}
